# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdmin@2026
ADMIN_EMAIL=admin@haoverseas.com

# Firebase (Optional: for Google OAuth token verification)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Unified Native Invoicing
# Invoicing is built natively into order-creator-BE. No external invoice service URL required.

