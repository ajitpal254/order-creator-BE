# =============================================================
# H.A. Overseas Order Creator API — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit your actual .env file. Secrets in .env only.
# =============================================================

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin — must be an exact URL with no trailing slash.
# In production set this to your Netlify/custom domain.
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── JWT Authentication ──────────────────────────────────────
# At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_access_token_secret_32chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_refresh_secret_32chars

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin Seed Credentials ──────────────────────────────────
# These are used only on first startup if no admin exists.
# CHANGE THEM IN YOUR HOSTING DASHBOARD (Render, etc.) BEFORE FIRST PRODUCTION BOOT.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
ADMIN_EMAIL=admin@haoverseas.com

# ── Firebase / Google OAuth ─────────────────────────────────
# Required to verify Google Sign-In ID tokens server-side.
# Get from Firebase Console → Project Settings → General.
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Invoice & Export Defaults ───────────────────────────────
# H.A. Overseas sender identity for generated invoices.
# These override the model's hardcoded defaults.
SENDER_COMPANY_NAME=H.A. OVERSEAS
SENDER_ADDRESS=Industrial Area Phase-II, Ludhiana, Punjab - 141003, India
SENDER_PHONE=+91-99884-65800
SENDER_EMAIL=haoverseas1313@gmail.com
SENDER_GSTIN=03AAAAA0000A1Z5
SENDER_IEC_NO=0300000000
SENDER_PAN=AAAAA0000A
SENDER_STATE_CODE=03

# Email (Nodemailer) — for password reset dispatch
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@haoverseas.com
EMAIL_PASS=replace_with_smtp_password
